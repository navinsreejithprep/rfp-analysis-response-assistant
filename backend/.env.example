# Copy this file to backend/.env and fill in your own key. Never commit backend/.env.
OPENAI_API_KEY=sk-your-key-here

# Model used for structured extraction / assessment / drafting / validation calls
OPENAI_CHAT_MODEL=gpt-4o-mini

# Model used to embed knowledge base + RFP text for retrieval
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated list of origins allowed to call this API (your Vercel frontend URL + localhost)
CORS_ORIGINS=http://localhost:3000

# Max automatic revision attempts per requirement before the loop gives up
MAX_REVISIONS=2

# Number of evidence chunks retrieved per requirement
RETRIEVAL_TOP_K=4
